# Server-only settings for Vercel Functions. Never use a VITE_ prefix for secrets.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
EDITOR_WRITE_TOKEN=replace-with-at-least-32-random-characters
DOT_WRITE_TOKEN=replace-with-a-different-random-token

# Connect a PRIVATE Vercel Blob store to the project. A read-write token is
# needed for handleUpload's browser upload token exchange.
BLOB_READ_WRITE_TOKEN=replace-with-private-blob-store-token

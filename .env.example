# Copy this file to .env.local and fill in your Supabase credentials.
# .env.local is gitignored; .env.example is committed (so do NOT put real keys here).

VITE_SUPABASE_URL=your_supabase_project_url_here

# Modern Supabase publishable key (starts with sb_publishable_...). Preferred.
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Legacy alternative — only set if your project still uses the old anon JWT.
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_jwt_here
